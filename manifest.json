{
  "manifest_version": 2,
  "name": "Fireproxy",
  "version": "0.3.2",
  "description": "Route traffic for specific domains through a SOCKS proxy server, including DNS requests",
  "icons": {
    "48": "icons/fireproxy-48.png",
    "96": "icons/fireproxy-96.png"
  },
  "permissions": [
    "proxy",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "browser_action": {
    "default_icon": {
      "19": "icons/fireproxy-19.png",
      "38": "icons/fireproxy-38.png"
    },
    "default_title": "Fireproxy",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": ["background/background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fireproxy@example.com",
      "strict_min_version": "60.0"
    }
  },
  "privateBrowsingAllowed": true
}
